# ==============================================================
# LLM provider (OpenAI-compatible endpoint)
# ==============================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model
LLM_TIMEOUT=30

# Final answer language: japanese | match_query | en | ...
RESPONSE_LANGUAGE=japanese

# ==============================================================
# Local retrieval models (no API key needed)
# Optional HF_TOKEN avoids anonymous Hugging Face rate limits
# during the first local model downloads.
# HF_TOKEN=hf_xxx
# ==============================================================
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ==============================================================
# Paths (inside the container; docker-compose overrides these)
# ==============================================================
CHROMA_PATH=./data/chroma_db
NEXTJS_REPO_PATH=./data/nextjs-repo
BM25_CORPUS_PATH=./data/bm25_corpus.json
CHUNKS_PATH=./data/chunks.json
DOCS_DIR=./data_docs
BUSINESS_DB_PATH=./data/business.db
SOURCE_LABEL=商品カタログ

# ==============================================================
# Retrieval / planning
# ==============================================================
MAX_ITERATIONS=3
PLANNER_EARLY_STOP_ENABLED=true
PLANNER_EARLY_STOP_MIN_EVIDENCE_SCORE=0.76
PLANNER_EARLY_STOP_MIN_EVIDENCE_ITEMS=4
PLANNER_EARLY_STOP_MAX_EVIDENCE_DELTA=0.02
PLANNER_EARLY_STOP_MIN_STALLED_CYCLES=1
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
WEB_FALLBACK_ENABLED=false
MAX_CHUNK_TOKENS=300
CHUNK_OVERLAP_TOKENS=40
CHUNK_READER_MAX_WORDS=400
EVIDENCE_MAX_WORDS=500

# ==============================================================
# API / runtime
# ==============================================================
RATE_LIMIT=10/minute
CORS_ORIGINS=*
PRELOAD_MODELS_ON_STARTUP=true
LOG_LEVEL=INFO
LOG_FORMAT=text